{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gigagrid",
  "version": "0.4.3",
  "identifier": "dev.gigagrid.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gigagrid",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "AM Software",
    "copyright": "Copyright © 2026 AM Software",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["csv"],
        "name": "CSV File",
        "description": "Comma-separated values file",
        "role": "Editor"
      },
      {
        "ext": ["tsv"],
        "name": "TSV File",
        "description": "Tab-separated values file",
        "role": "Editor"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3QTJBOTJGQjExMDQ1MjYKUldRbVJSQ3hMNm1peCttZ0NHa3UrOS9teGp3T1RyenpSa3VGWDBTZTQ2aFJROFZ0cWtHbVF2akUK",
      "endpoints": [
        "https://github.com/AMSComm/GigaGrid/releases/latest/download/latest.json"
      ]
    }
  }
}
